# RC2 harness environment — PLACEHOLDERS ONLY.
# Never commit a filled-in copy. staging-validation/.env is git-ignored.
# All secrets are stored via Lovable secrets or the operator's local .env;
# they never appear in chat, logs, screenshots, reports or manifests.

# --- Staging Supabase (staging project ref only — never production) ---
STAGING_SUPABASE_URL=https://<staging-project-ref>.supabase.co
STAGING_SUPABASE_ANON_KEY=<staging-anon-key>
STAGING_SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-key>
STAGING_PG_CONN=postgresql://postgres:<pw>@<staging-host>:5432/postgres

# --- Staging app URL ---
# Must include "staging", "test", "preview", "dev", "sandbox", "rc2" or "localhost".
STAGING_APP_URL=https://staging.mycleaner.dk

# --- Stripe TEST MODE ONLY ---
# Secret key MUST start with sk_test_. Live keys are refused by the harness.
STRIPE_TEST_SECRET_KEY=sk_test_xxx
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_TEST_WEBHOOK_SECRET=whsec_test_xxx
STRIPE_WEBHOOK_URL=https://<staging-project-ref>.supabase.co/functions/v1/stripe-webhook

# --- Sumsub SANDBOX ONLY ---
SUMSUB_APP_TOKEN=sbx:<sandbox-app-token>
SUMSUB_SECRET_KEY=<sandbox-secret>
SUMSUB_WEBHOOK_SECRET=<sandbox-webhook-secret>
SUMSUB_WEBHOOK_URL=https://<staging-project-ref>.supabase.co/functions/v1/identity-webhook

# --- Test data isolation ---
# All seeded accounts use unique per-run emails: rc2+<run-id>-<slot>@<domain>.
TEST_EMAIL_DOMAIN=rc2.mycleaner.test
TEST_PASSWORD=<disposable-staging-password>

# --- Load test tuning ---
K6_VUS=50
K6_DURATION=60s

# --- MANDATORY destructive-test acknowledgement ---
# The harness writes to the staging database. Set this to the literal string
# "true" to acknowledge that this is a disposable staging environment.
# Any other value (including empty) refuses execution.
RC2_ALLOW_DESTRUCTIVE_STAGING_TESTS=false
