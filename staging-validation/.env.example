# Staging Supabase
STAGING_SUPABASE_URL=https://<project>.supabase.co
STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_PG_CONN=postgresql://postgres:<pw>@<host>:5432/postgres

# Staging app
STAGING_APP_URL=https://staging.mycleaner.dk

# Stripe Test Mode
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...
STRIPE_TEST_WEBHOOK_SECRET=whsec_...
# Endpoint the harness POSTs webhook replays to
STRIPE_WEBHOOK_URL=https://<project>.supabase.co/functions/v1/stripe-webhook

# Sumsub Sandbox
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_WEBHOOK_URL=https://<project>.supabase.co/functions/v1/identity-webhook

# Test identity pool (idempotent seed)
TEST_EMAIL_DOMAIN=rc2.mycleaner.test
TEST_PASSWORD=Rc2!Staging-Only-Password

# Load test tuning
K6_VUS=50
K6_DURATION=60s
