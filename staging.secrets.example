# staging.secrets.example
#
# Template for secrets that must exist on the STAGING Supabase project so
# edge functions behave identically to production. Never commit the filled-in
# copy (`staging.secrets`); it is git-ignored.
#
# Load into staging with:
#   supabase secrets set --project-ref <staging-ref> --env-file staging.secrets
#
# Names ONLY — the real values live in the operator's password manager or the
# provider dashboards (Stripe, Sumsub, GatewayAPI, Cloudflare, Sentry).
#
# Every name below MUST also exist in production (except the ones marked
# STAGING-ONLY, which are safe fallbacks for local/CI callbacks).

# ── Supabase (auto-populated by the platform, listed for reference) ──
# SUPABASE_URL=                            # auto
# SUPABASE_ANON_KEY=                       # auto
# SUPABASE_SERVICE_ROLE_KEY=               # auto (never share)
# SUPABASE_DB_URL=                         # auto

# ── Stripe (TEST MODE only on staging) ──
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_CONNECT_CLIENT_ID=ca_REPLACE_ME     # optional, only if OAuth Connect used

# ── Sumsub (SANDBOX only on staging) ──
SUMSUB_APP_TOKEN=sbx:REPLACE_ME
SUMSUB_SECRET_KEY=REPLACE_ME
SUMSUB_WEBHOOK_SECRET=REPLACE_ME
SUMSUB_BASE_URL=https://api.sumsub.com     # sandbox uses same host, sbx token distinguishes

# ── SMS provider (GatewayAPI — MyCleaner's only SMS provider) ──
GATEWAYAPI_API_TOKEN=REPLACE_ME
GATEWAYAPI_SENDER=MyCleaner
GATEWAYAPI_BASE_URL=https://messaging.gatewayapi.eu

# ── Mapbox (address validation / maps) ──
MAPBOX_ACCESS_TOKEN=REPLACE_ME             # server-side (sk.) token for Search Box retrieve
MAPBOX_PUBLIC_TOKEN=REPLACE_ME             # public (pk.) token served to the browser

# ── Cloudflare Turnstile (TEST site keys accepted on staging) ──
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Lovable AI Gateway (for scan-receipt, support-chat) ──
LOVABLE_API_KEY=REPLACE_ME

# ── Sentry / observability ──
SENTRY_DSN=https://REPLACE_ME@sentry.io/REPLACE_ME
SENTRY_ENVIRONMENT=staging

# ── Email (transactional) ──
RESEND_API_KEY=REPLACE_ME                  # or SMTP_* if not Resend
EMAIL_FROM_ADDRESS=no-reply@staging.mycleaner.dk

# ── Tax-id encryption (must be UNIQUE per environment) ──
# Generate: openssl rand -base64 32
TAX_ID_ENCRYPTION_KEY=REPLACE_ME_32_BYTE_BASE64

# ── App base URL (used in edge function callback links) ──
APP_BASE_URL=https://staging.mycleaner.dk

# ── STAGING-ONLY toggles ──
APP_ENVIRONMENT=staging                    # surfaced to functions for banners/log tags
ALLOWED_ORIGINS=https://staging.mycleaner.dk,https://mycleaner-staging.lovable.app,http://localhost:8080
